ARG DIST=noble
FROM ubuntu:${DIST}

ENV DEBIAN_FRONTEND=noninteractive

# Packaging environment for the target suite. Nothing is compiled: debian/rules
# unpacks upstream's prebuilt bundle and dpkg-buildpackage assembles the debs.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        debhelper \
        dpkg-dev \
        wget \
        ca-certificates \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# ARCH is the Debian architecture to package (amd64 or arm64). The bundle is
# only unpacked and copied, never executed, so arm64 is assembled on an amd64
# builder with dpkg-buildpackage's --host-arch and no emulation.
# BUILD_TYPE is -b (arch-dependent + arch-independent packages) or -B
# (arch-dependent only, for a second architecture when another build already
# produced the arch:all debs).
ARG ARCH=amd64
ARG BUILD_TYPE=-b

WORKDIR /build
# Includes kitty-<ver>-<arch>.txz when the build script pre-downloaded it;
# otherwise debian/rules fetches it.
COPY . /build/

RUN chmod +x debian/rules && dpkg-buildpackage ${BUILD_TYPE} -us -uc -d --host-arch ${ARCH}

RUN mkdir -p /out && cp ../kitty*.deb /out/
